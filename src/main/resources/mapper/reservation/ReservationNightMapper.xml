<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rs01.reservation.mapper.ReservationNightMapper">
    <sql id="reservationNightColumns">
        id, reservation_id, stay_date, price, create_time
    </sql>
    <select id="selectById" resultType="com.rs01.reservation.entity.ReservationNight">
        SELECT <include refid="reservationNightColumns"/>
        FROM reservation_night WHERE id = #{id}
    </select>
    <insert id="batchInsert">
        INSERT INTO reservation_night (reservation_id, stay_date, price)
        VALUES
        <foreach collection="nights" item="night" separator=",">
            (#{night.reservationId}, #{night.stayDate}, #{night.price})
        </foreach>
    </insert>
    <select id="selectByReservationId" resultType="com.rs01.reservation.entity.ReservationNight">
        SELECT <include refid="reservationNightColumns"/>
        FROM reservation_night WHERE reservation_id = #{reservationId} ORDER BY stay_date
    </select>
    <delete id="deleteByReservationId">
        DELETE FROM reservation_night WHERE reservation_id = #{reservationId}
    </delete>
</mapper>
