<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rs01.user.mapper.UserMapper">
    <sql id="userColumns">
        id, username, password, name, email, phone, role, status, create_time, update_time
    </sql>
    <select id="selectById" resultType="com.rs01.user.entity.User">
        SELECT <include refid="userColumns"/> FROM `user` WHERE id = #{id}
    </select>
    <select id="selectByUsername" resultType="com.rs01.user.entity.User">
        SELECT <include refid="userColumns"/> FROM `user` WHERE username = #{username}
    </select>
    <select id="existsByUsername" resultType="boolean">
        SELECT CASE WHEN COUNT(*) &gt; 0 THEN TRUE ELSE FALSE END FROM `user` WHERE username = #{username}
    </select>
    <update id="updateBasicInfo">
        UPDATE `user`
        SET name = #{name}, email = #{email}, phone = #{phone}
        WHERE id = #{id}
    </update>
    <update id="updatePassword">
        UPDATE `user` SET password = #{password} WHERE id = #{id}
    </update>
    <update id="updateStatus">
        UPDATE `user` SET status = #{status} WHERE id = #{id}
    </update>
</mapper>
